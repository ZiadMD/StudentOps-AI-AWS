# ==========================================
# StudentOps AI — Environment Variables Template
# ==========================================

# Application Environment & Debugging
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="StudentOps AI"
VERSION="1.0.0"

# Database Configuration
# Local SQLite default:
# DATABASE_URL=sqlite+aiosqlite:///./studentops.db
# Supabase PostgreSQL (Transaction Pooler - Port 6543):
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase Cloud Project Credentials
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<PROJECT-REF>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
# Required for legacy HS256 Supabase access-token verification.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-signing-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# FastAPI runtime settings
TURNSTILE_SECRET_KEY=your-turnstile-secret
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SEED_USER_PASSWORD=generate-a-unique-password-out-of-band

# OpenRouter LLM (Primary Agent Inference)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq LLM (High-speed LPU fallback)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Messaging Provider (mock | whatsapp | sms)
MESSAGING_PROVIDER=mock
