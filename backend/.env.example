# =========================================================
# StudentOps AI — Environment Configuration
# =========================================================

PROJECT_NAME=StudentOps AI
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite for rapid local testing / PostgreSQL for cloud)
DATABASE_URL=sqlite+aiosqlite:///./studentops.db

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Google Workspace / Calendar / Meet (Optional - Mock Provider Active by default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Messaging Provider ("mock" | "whatsapp" | "sms")
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deterministic Policy Thresholds
ATTENDANCE_LATE_THRESHOLD_MINUTES=10
ATTENDANCE_MIN_PRESENT_PERCENT=70.0
ATTENDANCE_MIN_LATE_PERCENT=50.0

# 8.xlsx Scoring Standard
BEHAVIOR_MAX_SCORE=23
TASK_MAX_SCORE=10
