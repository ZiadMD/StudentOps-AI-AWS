# ============================================================
# StudentOps AI — Backend Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` — it is listed in .gitignore.
# ============================================================

# ── OpenRouter LLM ──────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model ID — use ":free" suffix for the free tier
# Examples:
#   nvidia/nemotron-3-super-120b-a12b:free
#   anthropic/claude-3.5-sonnet
#   meta-llama/llama-3.1-70b-instruct:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Groq LLM Fallback (optional high-speed LPU inference) ───
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ────────────────────────────────────────────────
# Defaults to local SQLite — no change needed for development
# DATABASE_URL=sqlite+aiosqlite:///./studentops.db

# ── Messaging ───────────────────────────────────────────────
# "mock" = log to console only (safe for dev)
# "whatsapp" = real Twilio WhatsApp dispatch
MESSAGING_PROVIDER=mock

# Required only if MESSAGING_PROVIDER=whatsapp:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=whatsapp:+1234567890

# ── Google Workspace (optional) ─────────────────────────────
# Required only for real Google Calendar / Meet integration
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALENDAR_ID=primary
